# ===== Bí mật / cấu hình cá nhân =====
# Chỉ commit file mẫu (.env.example, profiles.yml.example); file thật chứa mật khẩu PostgreSQL / API key LLM
.env
.env.*
!.env.example
dbt/profiles.yml
ai/.streamlit/secrets.toml
# Mage: io_config.yaml ĐƯỢC commit nhưng phải đọc mật khẩu qua {{ env_var('...') }}, không ghi thẳng mật khẩu

# ===== Dữ liệu =====
# data/raw/ ĐƯỢC commit (9 CSV gốc Olist, ~121 MB) để cả nhóm khỏi tải lại; batch sinh lại bằng scripts/ nên không commit
data/batches/*
!data/batches/.gitkeep
!data/batches/README.md

# ===== Database (PostgreSQL chạy Docker) & volume =====
mage_data/
pgdata/
postgres_data/
*.dump
*.backup
*.bak

# ===== Mage =====
mage/**/.variables/
mage/**/.cache/
mage/**/.file_versions/
mage/**/.ssh_tunnel/
mage/**/*.log

# ===== dbt =====
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# ===== Báo cáo nháp (soạn trên Google Docs/OneDrive; repo chỉ chứa bản PDF cuối) =====
docs/report/*.docx

# ===== Power BI / Office (file tạm khi đang mở) =====
~$*
*.pbix.lock
.pbi/localSettings.json
.pbi/cache.abf
# File .pbix (~29 MB, kèm dữ liệu) không lên Git – bản dùng chung của nhóm nằm trên OneDrive
*.pbix

# ===== Video demo (nặng, chỉ lưu link trong docs/demo) =====
*.mp4
*.mov
*.mkv

# ===== Log / file tạm =====
*.log
*.tmp

# ===== Claude Code (cấu hình cá nhân trên máy) =====
.claude/settings.local.json
CLAUDE.local.md

# ===== Hệ điều hành / IDE =====
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ===== docs =====
# File nguồn sơ đồ draw.io (chỉ commit ảnh xuất ra, VD .png/.svg)
docs/images/olist_relational_schema.drawio
# Tài liệu môn học / đề bài / báo cáo nháp (chỉ dùng cục bộ, không đưa lên repo)
docs/slides/
docs/2627.Yêu cầu.pdf
docs/03.docx
