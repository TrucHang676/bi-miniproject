// =============================================================================
// measures.dax - toàn bộ measure + cột tính của Semantic Model Power BI (BS-35 / BS-40)
// Nguồn sự thật là model trong .pbix; file này là bản sao lưu để review / đối chiếu.
// Đổi measure trong Power BI thì cập nhật cả file này. Quy ước: docs/powerbi_rules.md B5.
// Mỗi khối bắt đầu bằng dòng '// ----'; dòng tiếp theo ghi mã KPI | thư mục hiển thị | định dạng.
// Chuỗi 'Trễ hạn', 'Đúng hạn', ... phải giống từng ký tự giá trị dbt sinh ra (dim_delivery_status).
// =============================================================================

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_delivery_status]  |  ẩn  |  Sort by column của delay_bucket  |  công thức giống powerbi/README.md
// Không tham chiếu delay_bucket (tránh circular dependency); phụ thuộc thứ tự 7 nhóm trong dim_delivery_status.sql.
// Kiểm tra nhanh: bảng delay_bucket + delay_bucket_order phải ra đúng 1-7: Đúng hạn, Trễ 1–3, Trễ 4–7, Trễ 8–14, Trễ > 14, Chưa giao, Không xác định.
dim_delivery_status[delay_bucket_order] = MOD ( dim_delivery_status[delivery_status_key] - 1, 7 ) + 1

// #############################################################################
// THƯ MỤC HIỂN THỊ: 0 Phụ
// #############################################################################

// -----------------------------------------------------------------------------
// [Phụ]  Số đơn giao trễ  |  thư mục: 0 Phụ  |  định dạng: #,0
// Phụ (tử số K6). Số đơn (order_id riêng biệt) có delivery_result = 'Trễ hạn'.
Số đơn giao trễ = CALCULATE ( DISTINCTCOUNT ( fact_delivery[order_id] ), dim_delivery_status[delivery_result] = "Trễ hạn" )

// -----------------------------------------------------------------------------
// [Phụ]  Số đơn đã giao  |  thư mục: 0 Phụ  |  định dạng: #,0
// Phụ (mẫu số K6). Số đơn (order_id riêng biệt) có delivery_result là 'Đúng hạn' hoặc 'Trễ hạn'.
Số đơn đã giao = CALCULATE ( DISTINCTCOUNT ( fact_delivery[order_id] ), dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" } )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan
// #############################################################################

// -----------------------------------------------------------------------------
// [K1]  Doanh thu  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// K1. Tổng giá trị hàng bán của đơn hợp lệ, không gồm phí vận chuyển (BRL) = SUM(fact_sales[revenue]).
Doanh thu = SUM ( fact_sales[revenue] )

// -----------------------------------------------------------------------------
// [K2]  Số đơn  |  thư mục: 1 Tổng quan  |  định dạng: #,0
// K2. Số đơn hợp lệ = DISTINCTCOUNT(order_id) trên fact_sales (1 đơn có thể nhiều dòng).
Số đơn = DISTINCTCOUNT ( fact_sales[order_id] )

// -----------------------------------------------------------------------------
// [K3]  Giá trị đơn TB  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// K3. Giá trị đơn trung bình (AOV) = K1 / K2 (BRL/đơn).
Giá trị đơn TB = DIVIDE ( [Doanh thu], [Số đơn] )

// -----------------------------------------------------------------------------
// [K4]  Số khách hàng  |  thư mục: 1 Tổng quan  |  định dạng: #,0
// K4. Số khách thực (customer_unique_id) có đơn hợp lệ trong kỳ = DISTINCTCOUNT(customer_key).
Số khách hàng = DISTINCTCOUNT ( fact_sales[customer_key] )

// -----------------------------------------------------------------------------
// [K5]  Tỉ lệ khách mua lại  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// K5. % khách có từ 2 lần mua trở lên trong kỳ (các đơn cách nhau <= 10 phút gộp thành 1 lần mua - R6) / K4.
Tỉ lệ khách mua lại =
    VAR KhachMuaLai =
        COUNTROWS (
            FILTER (
                VALUES ( fact_sales[customer_key] ),
                CALCULATE ( DISTINCTCOUNT ( fact_sales[purchase_seq] ) ) >= 2
            )
        )
    RETURN DIVIDE ( KhachMuaLai, [Số khách hàng] )

// -----------------------------------------------------------------------------
// [M1]  Doanh thu cùng kỳ  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// M1. Doanh thu cùng kỳ năm trước (SAMEPERIODLASTYEAR); BLANK nếu kỳ đang xét không nằm trong 01-08/2018.
Doanh thu cùng kỳ =
    VAR TrongKy =
        MIN ( dim_date[full_date] ) >= DATE ( 2018, 1, 1 )
            && MAX ( dim_date[full_date] ) <= DATE ( 2018, 8, 31 )
    RETURN IF ( TrongKy, CALCULATE ( [Doanh thu], SAMEPERIODLASTYEAR ( dim_date[full_date] ) ) )

// -----------------------------------------------------------------------------
// [M2]  % tăng trưởng cùng kỳ  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// M2. % tăng trưởng doanh thu so với cùng kỳ = (K1 - M1) / M1; BLANK khi M1 BLANK.
% tăng trưởng cùng kỳ = DIVIDE ( [Doanh thu] - [Doanh thu cùng kỳ], [Doanh thu cùng kỳ] )

// -----------------------------------------------------------------------------
// [M3]  % tổng doanh thu  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// M3. Tỉ trọng doanh thu = K1 / K1 toàn bộ (bỏ lọc danh mục và bang).
% tổng doanh thu = DIVIDE ( [Doanh thu], CALCULATE ( [Doanh thu], ALL ( dim_product ), ALL ( dim_geography ) ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Thẻ KPI  (thêm 30/10/2026 khi dựng trang 1)
// Measure trả về CHỮ để hiển thị trên 5 thẻ KPI (Card new). Chỉ dùng trên thẻ,
// KHÔNG gọi trong công thức khác: so sánh / chia với chữ sẽ lỗi hoặc ra số sai.
// Dòng "so cùng kỳ" = 01-08/2018 so với 01-08/2017 trên cùng các tháng đang chọn:
// KEEPFILTERS giữ lựa chọn Tháng; năm 2017 thay năm đang chọn; Vùng, Bang không đụng tới.
// Chọn Năm 2017 hoặc tháng 9-12 -> "Không có cùng kỳ để so" (2016 thưa dữ liệu, 9-12/2018 chưa có).
// #############################################################################

// -----------------------------------------------------------------------------
// [Thẻ K1]  Doanh thu (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K1: doanh thu đổi sang triệu, dạng chữ kiểu Việt (13,45 tr). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Doanh thu (thẻ) = FORMAT ( [Doanh thu] / 1000000, "#,0.00", "vi-VN" ) & " tr"

// -----------------------------------------------------------------------------
// [Thẻ K2]  Số đơn (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K2: số đơn dạng chữ có dấu chấm ngăn nghìn (97.905). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Số đơn (thẻ) = FORMAT ( DISTINCTCOUNT ( fact_sales[order_id] ), "#,0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ K4]  Số khách hàng (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K4: số khách dạng chữ có dấu chấm ngăn nghìn (94.703). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Số khách hàng (thẻ) = FORMAT ( DISTINCTCOUNT ( fact_sales[customer_key] ), "#,0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ K1]  Doanh thu so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K1: % và chênh lệch doanh thu 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang; trả về "Không có cùng kỳ để so" khi chọn 2017 hoặc tháng 9-12. Chỉ dùng trên thẻ.
Doanh thu so cùng kỳ =
    VAR _nay = CALCULATE ( [Doanh thu], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Doanh thu], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( ( _nay - _truoc ) / 1000000, "+#,0.00;-#,0.00", "vi-VN" ) & " tr so cùng kỳ" )

// -----------------------------------------------------------------------------
// [Thẻ K2]  Số đơn so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K2: % và chênh lệch số đơn 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Số đơn so cùng kỳ =
    VAR _nay = CALCULATE ( [Số đơn], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Số đơn], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0;-#,0", "vi-VN" ) & " đơn" )

// -----------------------------------------------------------------------------
// [Thẻ K3]  Giá trị đơn so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K3: % và chênh lệch giá trị đơn TB 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Giá trị đơn so cùng kỳ =
    VAR _nay = CALCULATE ( [Giá trị đơn TB], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Giá trị đơn TB], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0.0%;-0.0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0.00;-#,0.00", "vi-VN" ) & " BRL" )

// -----------------------------------------------------------------------------
// [Thẻ K4]  Số khách hàng so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K4: % và chênh lệch số khách 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Số khách hàng so cùng kỳ =
    VAR _nay = CALCULATE ( [Số khách hàng], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Số khách hàng], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0;-#,0", "vi-VN" ) & " khách" )

// -----------------------------------------------------------------------------
// [Thẻ K5]  Khách mua 1 lần  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K5: 1 - K5, % khách chỉ mua 1 lần trong kỳ. Chỉ dùng trên thẻ.
Khách mua 1 lần = "↓ " & FORMAT ( 1 - [Tỉ lệ khách mua lại], "0.0%", "vi-VN" ) & " chỉ mua 1 lần"

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Định dạng  (thêm 30/10/2026 khi dựng trang 1)
// Measure trả về mã màu / số nhóm cho conditional formatting (Format -> fx -> Field value).
// #############################################################################

// -----------------------------------------------------------------------------
// [Định dạng]  Màu danh mục  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu thanh biểu đồ Top 10 danh mục: top 3 theo doanh thu (K1) màu vàng chanh, còn lại màu tím. Cột xếp hạng phải trùng cột trục Y của biểu đồ.
Màu danh mục =
    IF (
        RANKX ( ALLSELECTED ( dim_product[category_name_en] ), [Doanh thu] ) <= 3,
        "#C8E62A",
        "#A9B8F8"
    )

// -----------------------------------------------------------------------------
// [Định dạng]  Nhóm tỉ trọng bang  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: 0
// Nhóm màu bản đồ bang theo M3: 5 = > 12%, 4 = 5-12%, 3 = 2-5%, 2 = 1-2%, 1 = < 1%. Shape map tô theo nhóm (Min 1 #EEF1FE, giữa 3 #A9B8F8, Max 5 #3A47C4), khớp chú thích "Theo bang".
Nhóm tỉ trọng bang =
    VAR _p = [% tổng doanh thu]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _p ), BLANK (),
            _p > 0.12, 5,
            _p > 0.05, 4,
            _p > 0.02, 3,
            _p > 0.01, 2,
            1
        )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ doanh thu  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K1 theo ký tự đầu: "↓" giảm -> đỏ, "K" (Không có cùng kỳ) -> xám, còn lại tăng -> xanh.
Màu so cùng kỳ doanh thu =
    VAR _t = LEFT ( [Doanh thu so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ số đơn  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K2, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ số đơn =
    VAR _t = LEFT ( [Số đơn so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ giá trị đơn  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K3, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ giá trị đơn =
    VAR _t = LEFT ( [Giá trị đơn so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ khách hàng  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K4, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ khách hàng =
    VAR _t = LEFT ( [Số khách hàng so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 2 Giao hàng
// #############################################################################

// -----------------------------------------------------------------------------
// [K6]  Tỉ lệ giao trễ  |  thư mục: 2 Giao hàng  |  định dạng: 0.00%
// K6. % đơn đã giao mà khách nhận sau ngày giao dự kiến (so theo ngày) = đơn trễ / đơn đã giao, đếm theo order_id.
Tỉ lệ giao trễ = DIVIDE ( [Số đơn giao trễ], [Số đơn đã giao] )

// -----------------------------------------------------------------------------
// [K7]  Thời gian giao TB  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K7. Số ngày trung bình từ lúc đặt đến lúc khách nhận; mỗi đơn tính 1 lần (đơn đã giao).
Thời gian giao TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_delivery[order_id] ), CALCULATE ( MAX ( fact_delivery[delivery_days] ) ) ),
        dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" }
    )

// -----------------------------------------------------------------------------
// [K8]  Điểm đánh giá TB  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K8. Điểm hài lòng trung bình (1-5 sao); mỗi đơn lấy 1 điểm (is_latest_review = TRUE).
Điểm đánh giá TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_review[order_id] ), CALCULATE ( MAX ( fact_review[review_score] ) ) ),
        fact_review[is_latest_review] = TRUE ()
    )

// -----------------------------------------------------------------------------
// [K9]  Tỉ lệ đánh giá tiêu cực  |  thư mục: 2 Giao hàng  |  định dạng: 0.00%
// K9. % đơn bị đánh giá 1-2 sao / đơn có đánh giá (mỗi đơn 1 điểm - đánh giá mới nhất).
Tỉ lệ đánh giá tiêu cực =
    VAR DonCoReview =
        CALCULATE ( DISTINCTCOUNT ( fact_review[order_id] ), fact_review[is_latest_review] = TRUE () )
    VAR DonTieuCuc =
        CALCULATE (
            DISTINCTCOUNT ( fact_review[order_id] ),
            fact_review[is_latest_review] = TRUE (),
            fact_review[review_score] <= 2
        )
    RETURN DIVIDE ( DonTieuCuc, DonCoReview )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 2 Giao hàng\Thẻ KPI, 2 Giao hàng\Định dạng  (thêm 01/11/2026 khi dựng trang 2)
// Measure trả về CHỮ / mã màu chỉ dùng trên thẻ KPI và trong Format -> fx -> Field value,
// KHÔNG gọi trong công thức khác. Ngưỡng K6, K8, K9 theo business_questions.md mục 6.
// #############################################################################

// -----------------------------------------------------------------------------
// [Thẻ]  Tỉ lệ giao trễ (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K6, chữ kiểu Việt (6,8%). Chỉ dùng trên thẻ.
Tỉ lệ giao trễ (thẻ) = FORMAT ( [Tỉ lệ giao trễ], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Thời gian giao TB (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K7 (12,5 ngày). Chỉ dùng trên thẻ.
Thời gian giao TB (thẻ) = FORMAT ( [Thời gian giao TB], "0.0", "vi-VN" ) & " ngày"

// -----------------------------------------------------------------------------
// [Thẻ]  Điểm đánh giá TB (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K8 (4,09 ★). Chỉ dùng trên thẻ.
Điểm đánh giá TB (thẻ) = FORMAT ( [Điểm đánh giá TB], "0.00", "vi-VN" ) & " ★"

// -----------------------------------------------------------------------------
// [Thẻ]  Tỉ lệ đánh giá tiêu cực (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K9 (14,6%). Chỉ dùng trên thẻ.
Tỉ lệ đánh giá tiêu cực (thẻ) = FORMAT ( [Tỉ lệ đánh giá tiêu cực], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Giao trễ so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K6: so với mục tiêu <= 5%, cảnh báo > 10% (business_questions.md mục 6).
Giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đơn đã giao",
            _v > 0.10, "↑ Vượt ngưỡng cảnh báo 10%",
            _v > 0.05, "↑ Trên mục tiêu 5% · cảnh báo > 10%",
            "✓ Đạt mục tiêu ≤ 5%" )

// -----------------------------------------------------------------------------
// [Thẻ]  Thời gian giao ghi chú  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K7 (K7 không có ngưỡng).
Thời gian giao ghi chú = "Từ lúc đặt đến khi khách nhận"

// -----------------------------------------------------------------------------
// [Thẻ]  Điểm đánh giá so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K8: so với mục tiêu >= 4,0, cảnh báo < 3,5.
Điểm đánh giá so mục tiêu =
    VAR _v = [Điểm đánh giá TB]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đánh giá",
            _v < 3.5, "↓ Dưới ngưỡng cảnh báo 3,5★",
            _v < 4, "↓ Dưới mục tiêu 4,0★ · cảnh báo < 3,5★",
            "✓ Đạt mục tiêu ≥ 4,0★" )

// -----------------------------------------------------------------------------
// [Thẻ]  Đánh giá tiêu cực so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K9: so với mục tiêu <= 10%, cảnh báo > 20%.
Đánh giá tiêu cực so mục tiêu =
    VAR _v = [Tỉ lệ đánh giá tiêu cực]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đánh giá",
            _v > 0.20, "↑ Vượt ngưỡng cảnh báo 20%",
            _v > 0.10, "↑ Trên mục tiêu 10% · cảnh báo > 20%",
            "✓ Đạt mục tiêu ≤ 10%" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu giao trễ so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K6 (nền vàng chanh): xanh đạt, cam trên mục tiêu, đỏ vượt cảnh báo.
Màu giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#8B9099", _v > 0.10, "#B42318", _v > 0.05, "#9A3412", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu ghi chú thẻ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu chữ xám cho dòng phụ không có ngưỡng (thẻ K7).
Màu ghi chú thẻ = "#4A4E57"

// -----------------------------------------------------------------------------
// [Định dạng]  Màu điểm đánh giá so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K8 (nền trắng).
Màu điểm đánh giá so mục tiêu =
    VAR _v = [Điểm đánh giá TB]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#8B9099", _v < 3.5, "#D9483B", _v < 4, "#9A3412", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu đánh giá tiêu cực so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K9 (nền đen nên dùng tông sáng).
Màu đánh giá tiêu cực so mục tiêu =
    VAR _v = [Tỉ lệ đánh giá tiêu cực]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#B5BAC2", _v > 0.20, "#EF6F61", _v > 0.10, "#F6C343", "#C8E62A" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu giao trễ theo ngưỡng  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu thanh / cột theo K6: vượt 10% đỏ cam, còn lại tím (biểu đồ bang và cột theo tháng).
Màu giao trễ theo ngưỡng = IF ( [Tỉ lệ giao trễ] > 0.10, "#EF6F61", "#A9B8F8" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu cột mức trễ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu cột biểu đồ điểm theo mức trễ: Đúng hạn xanh chanh, nhóm trễ đỏ cam (đúng ở cả 2 cấp drill).
Màu cột mức trễ = IF ( SELECTEDVALUE ( dim_delivery_status[delivery_result] ) = "Đúng hạn", "#C8E62A", "#EF6F61" )

// -----------------------------------------------------------------------------
// [Phụ]  Điểm TB toàn sàn  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K8 bỏ lọc trạng thái giao hàng (vẫn theo Năm, Tháng, Vùng): đường TB sàn trên biểu đồ điểm theo mức trễ.
Điểm TB toàn sàn = CALCULATE ( [Điểm đánh giá TB], REMOVEFILTERS ( dim_delivery_status ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 3 Người bán
// #############################################################################

// -----------------------------------------------------------------------------
// [K10]  Số người bán hoạt động  |  thư mục: 3 Người bán  |  định dạng: #,0
// K10. Số người bán có ít nhất 1 đơn hợp lệ trong kỳ; đếm trên fact_sales, không đếm dòng dim_seller (D3).
Số người bán hoạt động = DISTINCTCOUNT ( fact_sales[seller_key] )

// -----------------------------------------------------------------------------
// [K11]  Doanh thu TB mỗi người bán  |  thư mục: 3 Người bán  |  định dạng: #,0.00
// K11. Doanh thu bình quân mỗi người bán = K1 / K10 (BRL).
Doanh thu TB mỗi người bán = DIVIDE ( [Doanh thu], [Số người bán hoạt động] )

// -----------------------------------------------------------------------------
// [K12]  Tỉ lệ bàn giao trễ  |  thư mục: 3 Người bán  |  định dạng: 0.00%
// K12. % lượt (đơn, người bán) giao cho vận chuyển sau hạn shipping_limit_date; tính theo dòng fact_delivery.
Tỉ lệ bàn giao trễ =
    DIVIDE (
        CALCULATE ( COUNTROWS ( fact_delivery ), dim_delivery_status[handover_status] = "Trễ hạn" ),
        CALCULATE ( COUNTROWS ( fact_delivery ), dim_delivery_status[handover_status] IN { "Đúng hạn", "Trễ hạn" } )
    )

// -----------------------------------------------------------------------------
// [K13]  Tỷ trọng doanh thu top 10% người bán  |  thư mục: 3 Người bán  |  định dạng: 0.00%
// K13. Doanh thu của 10% người bán dẫn đầu / K1 (10% làm tròn lên - ROUNDUP; xem decisions.md).
Tỷ trọng doanh thu top 10% người bán =
    VAR SoTop = ROUNDUP ( [Số người bán hoạt động] * 0.1, 0 )
    VAR TopNB = TOPN ( SoTop, VALUES ( fact_sales[seller_key] ), [Doanh thu], DESC )
    RETURN DIVIDE ( CALCULATE ( [Doanh thu], TopNB ), [Doanh thu] )

// -----------------------------------------------------------------------------
// [M4]  Thời gian vận chuyển TB  |  thư mục: 3 Người bán  |  định dạng: 0.00
// M4. Số ngày trung bình từ lúc người bán bàn giao đến lúc khách nhận; mỗi đơn tính 1 lần (đơn đã giao).
Thời gian vận chuyển TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_delivery[order_id] ), CALCULATE ( MAX ( fact_delivery[transit_days] ) ) ),
        dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" }
    )

// -----------------------------------------------------------------------------
// [M5]  Cờ người bán cần xử lý  |  thư mục: 3 Người bán  |  định dạng: 0
// M5. 1 nếu người bán có >= 30 đơn và (K8 < 3,5 hoặc K12 > 10%), ngược lại 0; dùng làm filter visual (tính trong ngữ cảnh 1 người bán).
Cờ người bán cần xử lý =
    VAR Diem = [Điểm đánh giá TB]
    VAR TreBG = [Tỉ lệ bàn giao trễ]
    RETURN
        IF (
            [Số đơn] >= 30
                && ( ( NOT ISBLANK ( Diem ) && Diem < 3.5 ) || ( NOT ISBLANK ( TreBG ) && TreBG > 0.1 ) ),
            1,
            0
        )
