// =============================================================================
// measures.dax - toàn bộ measure + cột tính của Semantic Model Power BI (BS-35 / BS-40)
// Nguồn sự thật là model trong .pbix; file này là bản sao lưu để review / đối chiếu.
// Đổi measure trong Power BI thì cập nhật cả file này. Quy ước: docs/powerbi_rules.md B5.
// Mỗi khối bắt đầu bằng dòng '// ----'; dòng tiếp theo ghi mã KPI | thư mục hiển thị | định dạng.
// Chuỗi 'Trễ hạn', 'Đúng hạn', ... phải giống từng ký tự giá trị dbt sinh ra (dim_delivery_status).
// =============================================================================

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_delivery_status]  |  ẩn  |  Sort by column của delay_bucket  |  công thức giống powerbi/README.md
// Không tham chiếu delay_bucket (tránh circular dependency); phụ thuộc thứ tự 7 nhóm trong dim_delivery_status.sql.
// Kiểm tra nhanh: bảng delay_bucket + delay_bucket_order phải ra đúng 1-7: Đúng hạn, Trễ 1–3, Trễ 4–7, Trễ 8–14, Trễ > 14, Chưa giao, Không xác định.
dim_delivery_status[delay_bucket_order] = MOD ( dim_delivery_status[delivery_status_key] - 1, 7 ) + 1

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_seller]  |  hiện  |  thêm 03/11/2026 cho trang 3 (scatter, bảng top 10) và trường drill-through trang ẩn
// Nhãn người bán: 6 ký tự đầu seller_id (3.096 người bán không trùng) · thành phố – bang; dòng -1 = 'Không xác định'.
// Olist ẩn danh người bán nên không có tên cửa hàng. Không có trong dds.
dim_seller[seller_label] =
    IF (
        dim_seller[seller_key] = -1,
        "Không xác định",
        LEFT ( dim_seller[seller_id], 6 ) & " · "
            & UPPER ( LEFT ( dim_seller[seller_city], 1 ) ) & MID ( dim_seller[seller_city], 2, 200 )
            & " – " & dim_seller[seller_state]
    )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_product]  |  hiện  |  thêm 03/11/2026 cho bảng danh mục ở trang ẩn Chi tiết người bán
// Tên danh mục tiếng Việt, dịch tay từ category_name_en (74 bản dịch + 'Không xác định' của dòng -1);
// danh mục mới chưa có bản dịch giữ nguyên tiếng Anh. Không có trong dds (chốt làm ở Power BI vì hạn 05/11).
dim_product[category_name_vi] =
    SWITCH (
        dim_product[category_name_en],
        "agro_industry_and_commerce", "Nông nghiệp & thương mại",
        "air_conditioning", "Điều hòa không khí",
        "art", "Nghệ thuật",
        "arts_and_craftmanship", "Đồ thủ công mỹ nghệ",
        "audio", "Âm thanh",
        "auto", "Phụ kiện ô tô",
        "baby", "Đồ cho em bé",
        "bed_bath_table", "Chăn ga, đồ tắm & bàn ăn",
        "books_general_interest", "Sách phổ thông",
        "books_imported", "Sách nhập khẩu",
        "books_technical", "Sách chuyên ngành",
        "cds_dvds_musicals", "CD, DVD nhạc kịch",
        "christmas_supplies", "Đồ trang trí Giáng sinh",
        "cine_photo", "Máy quay & máy ảnh",
        "computers", "Máy tính",
        "computers_accessories", "Phụ kiện máy tính",
        "consoles_games", "Máy chơi game",
        "construction_tools_construction", "Dụng cụ xây dựng",
        "construction_tools_lights", "Đèn & thiết bị chiếu sáng",
        "construction_tools_safety", "Thiết bị an toàn lao động",
        "cool_stuff", "Đồ độc lạ",
        "costruction_tools_garden", "Dụng cụ xây dựng sân vườn",
        "costruction_tools_tools", "Dụng cụ cầm tay",
        "diapers_and_hygiene", "Tã & đồ vệ sinh",
        "drinks", "Đồ uống",
        "dvds_blu_ray", "DVD & Blu-ray",
        "electronics", "Điện tử",
        "fashio_female_clothing", "Thời trang nữ",
        "fashion_bags_accessories", "Túi xách & phụ kiện",
        "fashion_childrens_clothes", "Quần áo trẻ em",
        "fashion_male_clothing", "Thời trang nam",
        "fashion_shoes", "Giày dép",
        "fashion_sport", "Đồ thể thao",
        "fashion_underwear_beach", "Đồ lót & đồ bơi",
        "fixed_telephony", "Điện thoại bàn",
        "flowers", "Hoa",
        "food", "Thực phẩm",
        "food_drink", "Thực phẩm & đồ uống",
        "furniture_bedroom", "Nội thất phòng ngủ",
        "furniture_decor", "Nội thất & trang trí",
        "furniture_living_room", "Nội thất phòng khách",
        "furniture_mattress_and_upholstery", "Nệm & vải bọc",
        "garden_tools", "Dụng cụ làm vườn",
        "health_beauty", "Sức khỏe & làm đẹp",
        "home_appliances", "Đồ gia dụng",
        "home_appliances_2", "Đồ gia dụng (nhóm 2)",
        "home_comfort_2", "Tiện nghi gia đình (nhóm 2)",
        "home_confort", "Tiện nghi gia đình",
        "home_construction", "Xây dựng nhà cửa",
        "housewares", "Đồ dùng trong nhà",
        "industry_commerce_and_business", "Công nghiệp & kinh doanh",
        "kitchen_dining_laundry_garden_furniture", "Nội thất bếp, phòng ăn, giặt & sân vườn",
        "la_cuisine", "Đồ bếp cao cấp",
        "luggage_accessories", "Vali & phụ kiện du lịch",
        "market_place", "Hàng tổng hợp",
        "music", "Âm nhạc",
        "musical_instruments", "Nhạc cụ",
        "office_furniture", "Nội thất văn phòng",
        "party_supplies", "Đồ dùng tiệc",
        "pc_gamer", "Máy tính chơi game",
        "perfumery", "Nước hoa",
        "pet_shop", "Đồ thú cưng",
        "portable_kitchen_and_food_preparers", "Dụng cụ chế biến thực phẩm",
        "security_and_services", "An ninh & dịch vụ",
        "signaling_and_security", "Biển báo & an ninh",
        "small_appliances", "Thiết bị điện nhỏ",
        "small_appliances_home_oven_and_coffee", "Lò nướng & máy pha cà phê",
        "sports_leisure", "Thể thao & giải trí",
        "stationery", "Văn phòng phẩm",
        "tablets_printing_image", "Máy tính bảng & in ấn",
        "telephony", "Điện thoại di động",
        "toys", "Đồ chơi",
        "unknown", "Chưa phân loại",
        "watches_gifts", "Đồng hồ & quà tặng",
        dim_product[category_name_en]
    )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_date]  |  hiện  |  Sort by column = quarter  |  thêm 04/11/2026 cho drill Năm → Quý → Tháng ở trang 1
// Nhãn tầng Quý của trục NHIỀU TẦNG (tháng / quý / năm, mở rộng hết, tắt Concatenate labels) ở 2 biểu đồ theo tháng.
// Đã thử nhãn kèm năm (Quý 1/2017, 01/2017): 20 nhãn quá dài, bị xoay nghiêng, rối mắt -> bỏ. Năm hiện ở tầng dưới;
// nút 'Go to next level' (⇊) bị ẩn trên 2 biểu đồ vì nút đó bỏ tầng cha và gộp các năm.
// Quý 3/2018 chỉ có tháng 7, 8 (dữ liệu dừng ở 08/2018).
dim_date[quarter_label] = "Quý " & dim_date[quarter]

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_date]  |  hiện  |  Sort by column = month  |  thêm 04/11/2026 cho drill Năm → Quý → Tháng ở trang 1
// Nhãn tầng Tháng (1 … 12) của trục nhiều tầng; xem ghi chú quarter_label.
dim_date[month_label] = FORMAT ( dim_date[month], "0" )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_geography]  |  hiện  |  thêm 04/11/2026 - trục cấp Vùng của biểu đồ Top 5 (trang 1)
// Nhãn vùng kèm tên tiếng Việt cho người xem không rành địa lý Brazil: 'Sudeste (Đông Nam)'.
dim_geography[region_label] =
    VAR _vi =
        SWITCH (
            dim_geography[region],
            "Norte", "Bắc",
            "Nordeste", "Đông Bắc",
            "Centro-Oeste", "Trung Tây",
            "Sudeste", "Đông Nam",
            "Sul", "Nam"
        )
    RETURN IF ( ISBLANK ( _vi ), dim_geography[region], dim_geography[region] & " (" & _vi & ")" )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_geography]  |  hiện  |  thêm 04/11/2026 - trục cấp Bang của biểu đồ Top 5 (trang 1)
// Nhãn bang kèm mã như trên bản đồ: 'São Paulo (SP)'.
dim_geography[state_label] =
    IF ( dim_geography[geography_key] = -1 || dim_geography[state_name] = "Không xác định",
        dim_geography[state_name],
        dim_geography[state_name] & " (" & dim_geography[state_code] & ")" )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_geography]  |  hiện  |  thêm 04/11/2026 - trục cấp Thành phố của biểu đồ Top 5 (trang 1)
// city đã chuẩn hóa ở dbt (chữ thường, bỏ dấu: 'sao bernardo do campo') -> viết hoa đầu mỗi từ (sau dấu cách, '-', "'"),
// giới từ de/da/do/das/dos/e giữ chữ thường, kèm mã bang -> 'Sao Bernardo do Campo (SP)'. Không bù lại dấu tiếng Bồ Đào Nha.
// Dùng IF lồng thay cho ||: DAX tính cả 2 vế của || nên MID ( _s, 0, 1 ) ở ký tự đầu sẽ báo lỗi.
// 3 cột nhãn + tiêu đề trục dọc (tự đổi Vùng / Bang / Thành phố) để người xem biết đang ở cấp nào khi drill.
dim_geography[city_label] =
    VAR _s = dim_geography[city]
    RETURN
        IF (
            _s = "Không xác định" || LEN ( _s ) = 0,
            _s,
            VAR _hoa =
                CONCATENATEX (
                    GENERATESERIES ( 1, LEN ( _s ) ),
                    VAR _i = [Value]
                    VAR _c = MID ( _s, _i, 1 )
                    RETURN
                        IF ( _i = 1, UPPER ( _c ),
                            IF ( MID ( _s, MAX ( _i - 1, 1 ), 1 ) IN { " ", "-", "'" }, UPPER ( _c ), _c ) ),
                    "", [Value], ASC
                )
            VAR _thuong =
                SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    " " & _hoa & " ", " De ", " de " ), " Da ", " da " ), " Do ", " do " ), " Das ", " das " ), " Dos ", " dos " ), " E ", " e " )
            RETURN TRIM ( _thuong ) & " (" & dim_geography[state_code] & ")"
        )

// -----------------------------------------------------------------------------
// CỘT TÍNH  [dim_product]  |  hiện  |  thêm 04/11/2026 cho drill Danh mục → Sản phẩm (biểu đồ Top 10 danh mục, trang 1)
// Olist không có tên sản phẩm -> mã rút gọn 8 ký tự đầu product_id (32.952 mã, không trùng; 6 ký tự thì trùng 30 mã).
dim_product[product_label] =
    IF ( dim_product[product_key] = -1, "Không xác định", LEFT ( dim_product[product_id], 8 ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 0 Phụ
// #############################################################################

// -----------------------------------------------------------------------------
// [Phụ]  Số đơn giao trễ  |  thư mục: 0 Phụ  |  định dạng: #,0
// Phụ (tử số K6). Số đơn (order_id riêng biệt) có delivery_result = 'Trễ hạn'.
Số đơn giao trễ = CALCULATE ( DISTINCTCOUNT ( fact_delivery[order_id] ), dim_delivery_status[delivery_result] = "Trễ hạn" )

// -----------------------------------------------------------------------------
// [Phụ]  Số đơn đã giao  |  thư mục: 0 Phụ  |  định dạng: #,0
// Phụ (mẫu số K6). Số đơn (order_id riêng biệt) có delivery_result là 'Đúng hạn' hoặc 'Trễ hạn'.
Số đơn đã giao = CALCULATE ( DISTINCTCOUNT ( fact_delivery[order_id] ), dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" } )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan
// #############################################################################

// -----------------------------------------------------------------------------
// [K1]  Doanh thu  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// K1. Tổng giá trị hàng bán của đơn hợp lệ, không gồm phí vận chuyển (BRL) = SUM(fact_sales[revenue]).
Doanh thu = SUM ( fact_sales[revenue] )

// -----------------------------------------------------------------------------
// [K2]  Số đơn  |  thư mục: 1 Tổng quan  |  định dạng: #,0
// K2. Số đơn hợp lệ = DISTINCTCOUNT(order_id) trên fact_sales (1 đơn có thể nhiều dòng).
Số đơn = DISTINCTCOUNT ( fact_sales[order_id] )

// -----------------------------------------------------------------------------
// [K3]  Giá trị đơn TB  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// K3. Giá trị đơn trung bình (AOV) = K1 / K2 (BRL/đơn).
Giá trị đơn TB = DIVIDE ( [Doanh thu], [Số đơn] )

// -----------------------------------------------------------------------------
// [K4]  Số khách hàng  |  thư mục: 1 Tổng quan  |  định dạng: #,0
// K4. Số khách thực (customer_unique_id) có đơn hợp lệ trong kỳ = DISTINCTCOUNT(customer_key).
Số khách hàng = DISTINCTCOUNT ( fact_sales[customer_key] )

// -----------------------------------------------------------------------------
// [K5]  Tỉ lệ khách mua lại  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// K5. % khách có từ 2 lần mua trở lên trong kỳ (các đơn cách nhau <= 10 phút gộp thành 1 lần mua - R6) / K4.
Tỉ lệ khách mua lại =
    VAR KhachMuaLai =
        COUNTROWS (
            FILTER (
                VALUES ( fact_sales[customer_key] ),
                CALCULATE ( DISTINCTCOUNT ( fact_sales[purchase_seq] ) ) >= 2
            )
        )
    RETURN DIVIDE ( KhachMuaLai, [Số khách hàng] )

// -----------------------------------------------------------------------------
// [M1]  Doanh thu cùng kỳ  |  thư mục: 1 Tổng quan  |  định dạng: #,0.00
// M1. Doanh thu cùng kỳ năm trước (SAMEPERIODLASTYEAR); BLANK nếu kỳ đang xét không nằm trong 01-08/2018.
Doanh thu cùng kỳ =
    VAR TrongKy =
        MIN ( dim_date[full_date] ) >= DATE ( 2018, 1, 1 )
            && MAX ( dim_date[full_date] ) <= DATE ( 2018, 8, 31 )
    RETURN IF ( TrongKy, CALCULATE ( [Doanh thu], SAMEPERIODLASTYEAR ( dim_date[full_date] ) ) )

// -----------------------------------------------------------------------------
// [M2]  % tăng trưởng cùng kỳ  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// M2. % tăng trưởng doanh thu so với cùng kỳ = (K1 - M1) / M1; BLANK khi M1 BLANK.
% tăng trưởng cùng kỳ = DIVIDE ( [Doanh thu] - [Doanh thu cùng kỳ], [Doanh thu cùng kỳ] )

// -----------------------------------------------------------------------------
// [M3]  % tổng doanh thu  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%
// M3. Tỉ trọng doanh thu = K1 / K1 toàn bộ (bỏ lọc danh mục và bang).
% tổng doanh thu = DIVIDE ( [Doanh thu], CALCULATE ( [Doanh thu], ALL ( dim_product ), ALL ( dim_geography ) ) )

// -----------------------------------------------------------------------------
// [M3a]  Tỉ trọng nhóm top 10 danh mục  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%  |  thêm 04/11/2026
// Tỉ trọng của CẢ NHÓM 10 danh mục doanh thu cao nhất (Q2); cùng mẫu số với M3 nên bằng tổng 10 thanh của biểu đồ Top 10.
// ALLSELECTED: theo lọc Năm, Tháng, Vùng, Bang đang chọn. Toàn kỳ 01/2017-08/2018 = 62,37%.
Tỉ trọng nhóm top 10 danh mục =
    VAR _nhom =
        TOPN ( 10, FILTER ( ALLSELECTED ( dim_product[category_name_en] ), NOT ISBLANK ( [Doanh thu] ) ), [Doanh thu] )
    RETURN
        DIVIDE ( CALCULATE ( [Doanh thu], _nhom ), CALCULATE ( [Doanh thu], ALL ( dim_product ), ALL ( dim_geography ) ) )

// -----------------------------------------------------------------------------
// [M3b]  Tỉ trọng nhóm top 5 bang  |  thư mục: 1 Tổng quan  |  định dạng: 0.00%  |  thêm 04/11/2026
// Tỉ trọng của CẢ NHÓM 5 bang doanh thu cao nhất (Q2); cùng mẫu số với M3. Toàn kỳ = 73,87% (SP, RJ, MG, RS, PR).
Tỉ trọng nhóm top 5 bang =
    VAR _nhom =
        TOPN ( 5, FILTER ( ALLSELECTED ( dim_geography[state_code] ), NOT ISBLANK ( [Doanh thu] ) ), [Doanh thu] )
    RETURN
        DIVIDE ( CALCULATE ( [Doanh thu], _nhom ), CALCULATE ( [Doanh thu], ALL ( dim_product ), ALL ( dim_geography ) ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Nhãn  (thêm 04/11/2026)
// Measure trả về CHỮ cho phụ đề (Format -> Title -> Subtitle -> fx) và câu tooltip. Chỉ dùng làm nhãn.
// #############################################################################

// -----------------------------------------------------------------------------
// [Nhãn]  Phụ đề top 10 danh mục  |  thư mục: 1 Tổng quan\Nhãn  |  định dạng: chữ
// Phụ đề biểu đồ Top 10 danh mục: "10 danh mục dẫn đầu chiếm 62,4% doanh thu toàn sàn"; ít hơn 10 danh mục có doanh thu -> "... đang chọn".
Phụ đề top 10 danh mục =
    VAR _so = MIN ( 10, COUNTROWS ( FILTER ( ALLSELECTED ( dim_product[category_name_en] ), NOT ISBLANK ( [Doanh thu] ) ) ) )
    RETURN
        IF ( _so > 0,
            _so & IF ( _so = 10, " danh mục dẫn đầu", " danh mục đang chọn" ) & " chiếm "
                & FORMAT ( [Tỉ trọng nhóm top 10 danh mục], "0.0%", "vi-VN" ) & " doanh thu toàn sàn" )

// -----------------------------------------------------------------------------
// [Nhãn]  Phụ đề top 5 bang  |  thư mục: 1 Tổng quan\Nhãn  |  định dạng: chữ
// Phụ đề biểu đồ Top 5 bang: "5 bang dẫn đầu chiếm 73,9% doanh thu toàn sàn"; lọc Vùng Sul -> "3 bang đang chọn chiếm 14,4% ...".
Phụ đề top 5 bang =
    VAR _so = MIN ( 5, COUNTROWS ( FILTER ( ALLSELECTED ( dim_geography[state_code] ), NOT ISBLANK ( [Doanh thu] ) ) ) )
    RETURN
        IF ( _so > 0,
            _so & IF ( _so = 5, " bang dẫn đầu", " bang đang chọn" ) & " chiếm "
                & FORMAT ( [Tỉ trọng nhóm top 5 bang], "0.0%", "vi-VN" ) & " doanh thu toàn sàn" )

// -----------------------------------------------------------------------------
// [Nhãn]  Tên danh mục hoặc sản phẩm  |  thư mục: 1 Tổng quan\Nhãn  |  định dạng: chữ
// Tên dòng trong câu tooltip biểu đồ Top 10, đúng ở cả 2 cấp drill: 'health_beauty' / 'Sản phẩm mã bb50f2e2 (health_beauty)'.
Tên danh mục hoặc sản phẩm =
    IF (
        ISINSCOPE ( dim_product[product_label] ),
        "Sản phẩm mã " & SELECTEDVALUE ( dim_product[product_label] ) & " (" & SELECTEDVALUE ( dim_product[category_name_en] ) & ")",
        SELECTEDVALUE ( dim_product[category_name_en] )
    )

// -----------------------------------------------------------------------------
// [Nhãn]  Tên địa lý  |  thư mục: 1 Tổng quan\Nhãn  |  định dạng: chữ
// Tên dòng trong câu tooltip biểu đồ Top 5, ghi rõ cấp: 'Vùng Sudeste (Đông Nam)' / 'Bang São Paulo (SP)' / 'Thành phố Campinas (SP)'.
Tên địa lý =
    SWITCH (
        TRUE (),
        ISINSCOPE ( dim_geography[city_label] ), "Thành phố " & SELECTEDVALUE ( dim_geography[city_label] ),
        ISINSCOPE ( dim_geography[state_label] ), "Bang " & SELECTEDVALUE ( dim_geography[state_label] ),
        "Vùng " & SELECTEDVALUE ( dim_geography[region_label] )
    )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Top N  (thêm 04/11/2026)
// Top N cho 2 biểu đồ có drill (Top 10 danh mục: Danh mục → Sản phẩm; Top 5 bang: Vùng → Bang → Thành phố).
// KHÔNG đặt measure làm bộ lọc mức visual ("Filters on this visual -> is 1"): Power BI tính bộ lọc đó ở cấp
// THẤP NHẤT của trục drill, nên ở cấp trên mỗi bang chỉ còn cộng 5 thành phố đầu (SP ra 18,02% thay vì 38,30%).
// Cách làm: cờ 'Lọc top ...' (= 1 nếu thuộc Top N ở cấp ĐANG HIỂN THỊ, nhờ ISINSCOPE) -> mọi measure nằm trong
// truy vấn của visual (trục giá trị, tooltip, màu) đều trống ngoài Top N -> dòng trống hết thì tự ẩn.
// Cũng không dùng bộ lọc Top N có sẵn cho cấp dưới: Top N gắn với 1 cột nên drill sang cấp khác sẽ lọc sai.
// #############################################################################

// -----------------------------------------------------------------------------
// [Top N]  Lọc top 10 sản phẩm  |  thư mục: 1 Tổng quan\Top N  |  định dạng: 0
// Cờ biểu đồ Top 10 danh mục: cấp Sản phẩm = 1 nếu thuộc 10 sản phẩm doanh thu cao nhất trong phần đang drill;
// cấp Danh mục = 1 (bộ lọc Top N 10 danh mục sẵn có của visual vẫn giữ). Trống khi không có doanh thu.
Lọc top 10 sản phẩm =
    VAR _dt = [Doanh thu]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _dt ), BLANK (),
            ISINSCOPE ( dim_product[product_label] ),
                IF ( RANKX ( ALLSELECTED ( dim_product[product_label] ), [Doanh thu] ) <= 10, 1 ),
            1
        )

// -----------------------------------------------------------------------------
// [Top N]  Lọc top 5 địa lý  |  thư mục: 1 Tổng quan\Top N  |  định dạng: 0
// Cờ biểu đồ Top 5 bang (mặc định ở cấp Bang): cấp Bang và Thành phố = 1 nếu thuộc 5 dòng doanh thu cao nhất
// trong phần đang drill; cấp Vùng = 1 (đủ 5 vùng).
Lọc top 5 địa lý =
    VAR _dt = [Doanh thu]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _dt ), BLANK (),
            ISINSCOPE ( dim_geography[city_label] ),
                IF ( RANKX ( ALLSELECTED ( dim_geography[city_label] ), [Doanh thu] ) <= 5, 1 ),
            ISINSCOPE ( dim_geography[state_label] ),
                IF ( RANKX ( ALLSELECTED ( dim_geography[state_label] ), [Doanh thu] ) <= 5, 1 ),
            1
        )

// -----------------------------------------------------------------------------
// [Top N]  Tỉ trọng thanh top 10  |  thư mục: 1 Tổng quan\Top N  |  định dạng: 0.00%
// Trục giá trị biểu đồ Top 10 danh mục = M3, trống ngoài Top N.
Tỉ trọng thanh top 10 = IF ( [Lọc top 10 sản phẩm] = 1, [% tổng doanh thu] )

// -----------------------------------------------------------------------------
// [Top N]  Tỉ trọng thanh top 5  |  thư mục: 1 Tổng quan\Top N  |  định dạng: 0.00%
// Trục giá trị biểu đồ Top 5 bang = M3, trống ngoài Top N.
Tỉ trọng thanh top 5 = IF ( [Lọc top 5 địa lý] = 1, [% tổng doanh thu] )

// -----------------------------------------------------------------------------
// [Top N]  Tooltip top 10  |  thư mục: 1 Tổng quan\Top N  |  định dạng: chữ
// Câu tooltip biểu đồ Top 10 (Sentence template = {Chi tiết}). Gộp tên, doanh thu, số đơn, tỉ trọng vào 1 measure
// trống ngoài Top N: nếu để Doanh thu, Số đơn làm trường tooltip riêng thì dòng ngoài Top N vẫn còn trong truy vấn.
// Cấp Sản phẩm thêm giá bán trung bình = doanh thu / số lượng bán (revenue = quantity * unit_price ở fact_sales)
// để bù việc Olist ẩn danh tên sản phẩm (chỉ hiện được mã 8 ký tự).
Tooltip top 10 =
    VAR _gia =
        IF (
            ISINSCOPE ( dim_product[product_label] ),
            ", giá bán trung bình " & FORMAT ( DIVIDE ( [Doanh thu], SUM ( fact_sales[quantity] ) ), "#,0.00", "vi-VN" ) & " BRL"
        )
    RETURN
        IF (
            [Lọc top 10 sản phẩm] = 1,
            [Tên danh mục hoặc sản phẩm] & ": doanh thu " & FORMAT ( [Doanh thu], "#,0", "vi-VN" ) & " BRL từ "
                & FORMAT ( [Số đơn], "#,0", "vi-VN" ) & " đơn" & _gia
                & ", chiếm " & FORMAT ( [% tổng doanh thu], "0.00%", "vi-VN" ) & " toàn sàn"
        )

// -----------------------------------------------------------------------------
// [Top N]  Tooltip top 5  |  thư mục: 1 Tổng quan\Top N  |  định dạng: chữ
// Câu tooltip biểu đồ Top 5 bang (Sentence template = {Chi tiết}); cùng lý do với Tooltip top 10.
Tooltip top 5 =
    IF (
        [Lọc top 5 địa lý] = 1,
        [Tên địa lý] & ": doanh thu " & FORMAT ( [Doanh thu], "#,0", "vi-VN" ) & " BRL từ "
            & FORMAT ( [Số đơn], "#,0", "vi-VN" ) & " đơn, chiếm " & FORMAT ( [% tổng doanh thu], "0.00%", "vi-VN" ) & " toàn sàn"
    )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Thẻ KPI  (thêm 30/10/2026 khi dựng trang 1)
// Measure trả về CHỮ để hiển thị trên 5 thẻ KPI (Card new). Chỉ dùng trên thẻ,
// KHÔNG gọi trong công thức khác: so sánh / chia với chữ sẽ lỗi hoặc ra số sai.
// Dòng "so cùng kỳ" = 01-08/2018 so với 01-08/2017 trên cùng các tháng đang chọn:
// KEEPFILTERS giữ lựa chọn Tháng; năm 2017 thay năm đang chọn; Vùng, Bang không đụng tới.
// Chọn Năm 2017 hoặc tháng 9-12 -> "Không có cùng kỳ để so" (2016 thưa dữ liệu, 9-12/2018 chưa có).
// #############################################################################

// -----------------------------------------------------------------------------
// [Thẻ K1]  Doanh thu (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K1: doanh thu đổi sang triệu, dạng chữ kiểu Việt (13,45 tr). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Doanh thu (thẻ) = FORMAT ( [Doanh thu] / 1000000, "#,0.00", "vi-VN" ) & " tr"

// -----------------------------------------------------------------------------
// [Thẻ K2]  Số đơn (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K2: số đơn dạng chữ có dấu chấm ngăn nghìn (97.905). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Số đơn (thẻ) = FORMAT ( DISTINCTCOUNT ( fact_sales[order_id] ), "#,0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ K4]  Số khách hàng (thẻ)  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K4: số khách dạng chữ có dấu chấm ngăn nghìn (94.703). Chỉ dùng trên thẻ, không dùng trong công thức khác.
Số khách hàng (thẻ) = FORMAT ( DISTINCTCOUNT ( fact_sales[customer_key] ), "#,0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ K1]  Doanh thu so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K1: % và chênh lệch doanh thu 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang; trả về "Không có cùng kỳ để so" khi chọn 2017 hoặc tháng 9-12. Chỉ dùng trên thẻ.
Doanh thu so cùng kỳ =
    VAR _nay = CALCULATE ( [Doanh thu], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Doanh thu], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( ( _nay - _truoc ) / 1000000, "+#,0.00;-#,0.00", "vi-VN" ) & " tr so cùng kỳ" )

// -----------------------------------------------------------------------------
// [Thẻ K2]  Số đơn so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K2: % và chênh lệch số đơn 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Số đơn so cùng kỳ =
    VAR _nay = CALCULATE ( [Số đơn], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Số đơn], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0;-#,0", "vi-VN" ) & " đơn" )

// -----------------------------------------------------------------------------
// [Thẻ K3]  Giá trị đơn so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K3: % và chênh lệch giá trị đơn TB 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Giá trị đơn so cùng kỳ =
    VAR _nay = CALCULATE ( [Giá trị đơn TB], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Giá trị đơn TB], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0.0%;-0.0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0.00;-#,0.00", "vi-VN" ) & " BRL" )

// -----------------------------------------------------------------------------
// [Thẻ K4]  Số khách hàng so cùng kỳ  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K4: % và chênh lệch số khách 2018 so với 2017 trên cùng các tháng 1-8 đang chọn; theo lọc Tháng, Vùng, Bang. Chỉ dùng trên thẻ.
Số khách hàng so cùng kỳ =
    VAR _nay = CALCULATE ( [Số khách hàng], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Số khách hàng], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0;-#,0", "vi-VN" ) & " khách" )

// -----------------------------------------------------------------------------
// [Thẻ K5]  Khách mua 1 lần  |  thư mục: 1 Tổng quan\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K5: 1 - K5, % khách chỉ mua 1 lần trong kỳ. Chỉ dùng trên thẻ.
Khách mua 1 lần = "↓ " & FORMAT ( 1 - [Tỉ lệ khách mua lại], "0.0%", "vi-VN" ) & " chỉ mua 1 lần"

// #############################################################################
// THƯ MỤC HIỂN THỊ: 1 Tổng quan\Định dạng  (thêm 30/10/2026 khi dựng trang 1)
// Measure trả về mã màu / số nhóm cho conditional formatting (Format -> fx -> Field value).
// #############################################################################

// -----------------------------------------------------------------------------
// [Định dạng]  Màu danh mục  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu thanh biểu đồ Top 10 danh mục: top 3 theo doanh thu (K1) màu vàng chanh, còn lại màu tím. Cột xếp hạng phải trùng cột trục Y của biểu đồ.
// 04/11/2026: xếp hạng theo cấp đang hiển thị - drill xuống Sản phẩm thì top 3 sản phẩm màu vàng chanh
// (bản cũ chỉ xếp theo danh mục nên ở cấp sản phẩm mọi thanh đều ra hạng 1).
Màu danh mục =
    VAR _hang =
        IF (
            ISINSCOPE ( dim_product[product_label] ),
            RANKX ( ALLSELECTED ( dim_product[product_label] ), [Doanh thu] ),
            RANKX ( ALLSELECTED ( dim_product[category_name_en] ), [Doanh thu] )
        )
    RETURN
        // trống ngoài Top N: measure tô màu cũng nằm trong truy vấn của visual, còn giá trị thì dòng không ẩn
        IF ( [Lọc top 10 sản phẩm] = 1, IF ( _hang <= 3, "#C8E62A", "#A9B8F8" ) )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu tỉ trọng địa lý  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ  |  thêm 04/11/2026
// Màu thanh biểu đồ Top 5 bang theo Nhóm tỉ trọng bang, cùng bảng màu chú thích "Theo bang" của bản đồ
// (> 12% #3A47C4, 5-12% #6F80EC, 2-5% #A9B8F8, 1-2% #D3DBFC). Nhóm < 1% (#EEF1FE trên bản đồ) dùng #D3DBFC
// vì thanh gần trắng sẽ lẫn vào nền khi drill xuống Thành phố.
// Trống ngoài Top N (cùng lý do với Màu danh mục).
Màu tỉ trọng địa lý =
    IF (
        [Lọc top 5 địa lý] = 1,
        SWITCH ( [Nhóm tỉ trọng bang], 5, "#3A47C4", 4, "#6F80EC", 3, "#A9B8F8", 2, "#D3DBFC", 1, "#D3DBFC" )
    )

// -----------------------------------------------------------------------------
// [Định dạng]  Nhóm tỉ trọng bang  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: 0
// Nhóm màu bản đồ bang theo M3: 5 = > 12%, 4 = 5-12%, 3 = 2-5%, 2 = 1-2%, 1 = < 1%. Shape map tô theo nhóm (Min 1 #EEF1FE, giữa 3 #A9B8F8, Max 5 #3A47C4), khớp chú thích "Theo bang".
Nhóm tỉ trọng bang =
    VAR _p = [% tổng doanh thu]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _p ), BLANK (),
            _p > 0.12, 5,
            _p > 0.05, 4,
            _p > 0.02, 3,
            _p > 0.01, 2,
            1
        )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ doanh thu  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K1 theo ký tự đầu: "↓" giảm -> đỏ, "K" (Không có cùng kỳ) -> xám, còn lại tăng -> xanh.
Màu so cùng kỳ doanh thu =
    VAR _t = LEFT ( [Doanh thu so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ số đơn  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K2, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ số đơn =
    VAR _t = LEFT ( [Số đơn so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ giá trị đơn  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K3, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ giá trị đơn =
    VAR _t = LEFT ( [Giá trị đơn so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ khách hàng  |  thư mục: 1 Tổng quan\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K4, cùng quy tắc với Màu so cùng kỳ doanh thu.
Màu so cùng kỳ khách hàng =
    VAR _t = LEFT ( [Số khách hàng so cùng kỳ], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 2 Giao hàng
// #############################################################################

// -----------------------------------------------------------------------------
// [K6]  Tỉ lệ giao trễ  |  thư mục: 2 Giao hàng  |  định dạng: 0.00%
// K6. % đơn đã giao mà khách nhận sau ngày giao dự kiến (so theo ngày) = đơn trễ / đơn đã giao, đếm theo order_id.
Tỉ lệ giao trễ = DIVIDE ( [Số đơn giao trễ], [Số đơn đã giao] )

// -----------------------------------------------------------------------------
// [K7]  Thời gian giao TB  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K7. Số ngày trung bình từ lúc đặt đến lúc khách nhận; mỗi đơn tính 1 lần (đơn đã giao).
Thời gian giao TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_delivery[order_id] ), CALCULATE ( MAX ( fact_delivery[delivery_days] ) ) ),
        dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" }
    )

// -----------------------------------------------------------------------------
// [K8]  Điểm đánh giá TB  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K8. Điểm hài lòng trung bình (1-5 sao); mỗi đơn lấy 1 điểm (is_latest_review = TRUE).
Điểm đánh giá TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_review[order_id] ), CALCULATE ( MAX ( fact_review[review_score] ) ) ),
        fact_review[is_latest_review] = TRUE ()
    )

// -----------------------------------------------------------------------------
// [K9]  Tỉ lệ đánh giá tiêu cực  |  thư mục: 2 Giao hàng  |  định dạng: 0.00%
// K9. % đơn bị đánh giá 1-2 sao / đơn có đánh giá (mỗi đơn 1 điểm - đánh giá mới nhất).
Tỉ lệ đánh giá tiêu cực =
    VAR DonCoReview =
        CALCULATE ( DISTINCTCOUNT ( fact_review[order_id] ), fact_review[is_latest_review] = TRUE () )
    VAR DonTieuCuc =
        CALCULATE (
            DISTINCTCOUNT ( fact_review[order_id] ),
            fact_review[is_latest_review] = TRUE (),
            fact_review[review_score] <= 2
        )
    RETURN DIVIDE ( DonTieuCuc, DonCoReview )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 2 Giao hàng\Thẻ KPI, 2 Giao hàng\Định dạng  (thêm 01/11/2026 khi dựng trang 2)
// Measure trả về CHỮ / mã màu chỉ dùng trên thẻ KPI, tooltip và trong Format -> fx -> Field value,
// KHÔNG gọi trong công thức khác. Ngưỡng K6, K8, K9 theo business_questions.md mục 6.
// #############################################################################

// -----------------------------------------------------------------------------
// [Thẻ]  Tỉ lệ giao trễ (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K6, chữ kiểu Việt (6,8%). Chỉ dùng trên thẻ.
Tỉ lệ giao trễ (thẻ) = FORMAT ( [Tỉ lệ giao trễ], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Thời gian giao TB (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K7 (12,5). Chữ "ngày" là hộp chữ riêng đặt cạnh số vì Card (new) cắt đuôi chữ g, y. Chỉ dùng trên thẻ.
Thời gian giao TB (thẻ) = FORMAT ( [Thời gian giao TB], "0.0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Điểm đánh giá TB (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K8 (4,09 ★). Chỉ dùng trên thẻ.
Điểm đánh giá TB (thẻ) = FORMAT ( [Điểm đánh giá TB], "0.00", "vi-VN" ) & " ★"

// -----------------------------------------------------------------------------
// [Thẻ]  Tỉ lệ đánh giá tiêu cực (thẻ)  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Số trên thẻ K9 (14,6%). Chỉ dùng trên thẻ.
Tỉ lệ đánh giá tiêu cực (thẻ) = FORMAT ( [Tỉ lệ đánh giá tiêu cực], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Giao trễ so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K6: so với mục tiêu <= 5%, cảnh báo > 10% (business_questions.md mục 6).
Giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đơn đã giao",
            _v > 0.10, "⚠ Vượt ngưỡng cảnh báo 10%",
            _v > 0.05, "⚠ Cao hơn mục tiêu 5%",
            "✓ Đạt mục tiêu (từ 5% trở xuống)" )

// -----------------------------------------------------------------------------
// [Thẻ]  Thời gian giao ghi chú  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K7 (K7 không có ngưỡng).
Thời gian giao ghi chú = "Từ lúc đặt đến khi khách nhận"

// -----------------------------------------------------------------------------
// [Thẻ]  Điểm đánh giá so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K8: so với mục tiêu >= 4,0, cảnh báo < 3,5.
Điểm đánh giá so mục tiêu =
    VAR _v = [Điểm đánh giá TB]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đánh giá",
            _v < 3.5, "⚠ Dưới ngưỡng cảnh báo 3,5★",
            _v < 4, "⚠ Thấp hơn mục tiêu 4,0★",
            "✓ Đạt mục tiêu (từ 4,0★ trở lên)" )

// -----------------------------------------------------------------------------
// [Thẻ]  Đánh giá tiêu cực so mục tiêu  |  thư mục: 2 Giao hàng\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K9: so với mục tiêu <= 10%, cảnh báo > 20%.
Đánh giá tiêu cực so mục tiêu =
    VAR _v = [Tỉ lệ đánh giá tiêu cực]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có đánh giá",
            _v > 0.20, "⚠ Vượt ngưỡng cảnh báo 20%",
            _v > 0.10, "⚠ Cao hơn mục tiêu 10%",
            "✓ Đạt mục tiêu (từ 10% trở xuống)" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu giao trễ so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K6 (nền vàng chanh): xanh đạt, cam trên mục tiêu, đỏ vượt cảnh báo.
Màu giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#8B9099", _v > 0.10, "#B42318", _v > 0.05, "#9A3412", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu ghi chú thẻ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu chữ xám cho dòng phụ không có ngưỡng (thẻ K7).
Màu ghi chú thẻ = "#4A4E57"

// -----------------------------------------------------------------------------
// [Định dạng]  Màu điểm đánh giá so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K8 (nền trắng).
Màu điểm đánh giá so mục tiêu =
    VAR _v = [Điểm đánh giá TB]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#8B9099", _v < 3.5, "#D9483B", _v < 4, "#9A3412", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu đánh giá tiêu cực so mục tiêu  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K9 (nền đen nên dùng tông sáng).
Màu đánh giá tiêu cực so mục tiêu =
    VAR _v = [Tỉ lệ đánh giá tiêu cực]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#B5BAC2", _v > 0.20, "#EF6F61", _v > 0.10, "#F6C343", "#C8E62A" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu giao trễ theo ngưỡng  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu thanh / cột theo K6: vượt 10% đỏ cam, còn lại tím (biểu đồ bang và cột theo tháng).
Màu giao trễ theo ngưỡng = IF ( [Tỉ lệ giao trễ] > 0.10, "#EF6F61", "#A9B8F8" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu cột mức trễ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Màu cột biểu đồ điểm theo mức trễ: Đúng hạn xanh chanh, nhóm trễ đỏ cam (đúng ở cả 2 cấp drill).
Màu cột mức trễ = IF ( SELECTEDVALUE ( dim_delivery_status[delivery_result] ) = "Đúng hạn", "#C8E62A", "#EF6F61" )

// -----------------------------------------------------------------------------
// [Phụ]  Điểm TB toàn sàn  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// K8 bỏ lọc trạng thái giao hàng (vẫn theo Năm, Tháng, Vùng): đường TB sàn trên biểu đồ điểm theo mức trễ.
Điểm TB toàn sàn = CALCULATE ( [Điểm đánh giá TB], REMOVEFILTERS ( dim_delivery_status ) )

// -----------------------------------------------------------------------------
// [Định dạng]  Nhãn tháng  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Tháng dạng mm/yyyy cho câu tooltip của biểu đồ theo tháng (trang 2).
Nhãn tháng = FORMAT ( MAX ( dim_date[full_date] ), "MM/yyyy" )

// -----------------------------------------------------------------------------
// [Định dạng]  Nhãn kỳ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Câu tooltip 2 biểu đồ theo thời gian trang 2 (trục Năm → Quý → Tháng, thêm 04/11/2026): đổi theo cấp drill đang xem.
Nhãn kỳ =
    SWITCH ( TRUE (),
        ISINSCOPE ( dim_date[month] ), "Tháng " & FORMAT ( MAX ( dim_date[full_date] ), "MM/yyyy" ),
        ISINSCOPE ( dim_date[quarter_label] ), "Quý " & MAX ( dim_date[quarter] ) & "/" & MAX ( dim_date[year] ),
        "Năm " & MAX ( dim_date[year] ) )

// -----------------------------------------------------------------------------
// [Phụ]  Số lượt đánh giá  |  thư mục: 2 Giao hàng  |  định dạng: #,0
// Số lượt đánh giá dùng để tính K8: mỗi đơn 1 lượt (đánh giá mới nhất). Tooltip biểu đồ điểm theo mức trễ (Q4).
Số lượt đánh giá = CALCULATE ( DISTINCTCOUNT ( fact_review[order_id] ), fact_review[is_latest_review] = TRUE () )

// -----------------------------------------------------------------------------
// [Phụ]  Chênh lệch điểm trễ  |  thư mục: 2 Giao hàng  |  định dạng: 0.00
// Q4: điểm TB đơn đúng hạn trừ điểm TB đơn giao trễ (sao), vẫn theo Năm, Tháng, Vùng. Trống khi một nhóm không có đánh giá.
Chênh lệch điểm trễ =
    VAR _dung = CALCULATE ( [Điểm đánh giá TB], REMOVEFILTERS ( dim_delivery_status ), dim_delivery_status[delivery_result] = "Đúng hạn" )
    VAR _tre = CALCULATE ( [Điểm đánh giá TB], REMOVEFILTERS ( dim_delivery_status ), dim_delivery_status[delivery_result] = "Trễ hạn" )
    RETURN IF ( NOT ISBLANK ( _dung ) && NOT ISBLANK ( _tre ), _dung - _tre )

// -----------------------------------------------------------------------------
// [Định dạng]  Phụ đề điểm theo mức trễ  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: chữ
// Phụ đề động biểu đồ điểm theo mức trễ: ghi mức chênh điểm giữa đơn đúng hạn và đơn trễ (Q4).
Phụ đề điểm theo mức trễ =
    VAR _c = [Chênh lệch điểm trễ]
    VAR _tre = CALCULATE ( [Điểm đánh giá TB], REMOVEFILTERS ( dim_delivery_status ), dim_delivery_status[delivery_result] = "Trễ hạn" )
    RETURN
        IF ( ISBLANK ( _c ),
            "Bấm ↑ trên biểu đồ để gộp thành Đúng hạn / Trễ hạn",
            "Đơn trễ " & FORMAT ( _tre, "0.00", "vi-VN" ) & "★, thấp hơn đơn đúng hạn " & FORMAT ( _c, "0.00", "vi-VN" ) & "★. Bấm ↑ để gộp nhóm" )

// -----------------------------------------------------------------------------
// [Định dạng]  Giao trễ đến 10%  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: 0.0%
// Phần tỉ lệ giao trễ tính tới ngưỡng 10% (đoạn tím của thanh trong biểu đồ bang).
Giao trễ đến 10% =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN IF ( NOT ISBLANK ( _v ), MIN ( _v, 0.10 ) )

// -----------------------------------------------------------------------------
// [Định dạng]  Giao trễ vượt 10%  |  thư mục: 2 Giao hàng\Định dạng  |  định dạng: 0.0%
// Phần tỉ lệ giao trễ vượt ngưỡng 10% (đoạn đỏ của thanh trong biểu đồ bang).
Giao trễ vượt 10% =
    VAR _v = [Tỉ lệ giao trễ]
    RETURN IF ( NOT ISBLANK ( _v ), MAX ( _v - 0.10, 0 ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 3 Người bán
// #############################################################################

// -----------------------------------------------------------------------------
// [K10]  Số người bán hoạt động  |  thư mục: 3 Người bán  |  định dạng: #,0
// K10. Số người bán có ít nhất 1 đơn hợp lệ trong kỳ; đếm trên fact_sales, không đếm dòng dim_seller (D3).
Số người bán hoạt động = DISTINCTCOUNT ( fact_sales[seller_key] )

// -----------------------------------------------------------------------------
// [K11]  Doanh thu TB mỗi người bán  |  thư mục: 3 Người bán  |  định dạng: #,0.00
// K11. Doanh thu bình quân mỗi người bán = K1 / K10 (BRL).
Doanh thu TB mỗi người bán = DIVIDE ( [Doanh thu], [Số người bán hoạt động] )

// -----------------------------------------------------------------------------
// [K12]  Tỉ lệ bàn giao trễ  |  thư mục: 3 Người bán  |  định dạng: 0.00%
// K12. % lượt (đơn, người bán) giao cho vận chuyển sau hạn shipping_limit_date; tính theo dòng fact_delivery.
Tỉ lệ bàn giao trễ =
    DIVIDE (
        CALCULATE ( COUNTROWS ( fact_delivery ), dim_delivery_status[handover_status] = "Trễ hạn" ),
        CALCULATE ( COUNTROWS ( fact_delivery ), dim_delivery_status[handover_status] IN { "Đúng hạn", "Trễ hạn" } )
    )

// -----------------------------------------------------------------------------
// [K13]  Tỷ trọng doanh thu top 10% người bán  |  thư mục: 3 Người bán  |  định dạng: 0.00%
// K13. Doanh thu của 10% người bán dẫn đầu / K1 (10% làm tròn lên - ROUNDUP; xem decisions.md).
Tỷ trọng doanh thu top 10% người bán =
    VAR SoTop = ROUNDUP ( [Số người bán hoạt động] * 0.1, 0 )
    VAR TopNB = TOPN ( SoTop, VALUES ( fact_sales[seller_key] ), [Doanh thu], DESC )
    RETURN DIVIDE ( CALCULATE ( [Doanh thu], TopNB ), [Doanh thu] )

// -----------------------------------------------------------------------------
// [M4]  Thời gian vận chuyển TB  |  thư mục: 3 Người bán  |  định dạng: 0.00
// M4. Số ngày trung bình từ lúc người bán bàn giao đến lúc khách nhận; mỗi đơn tính 1 lần (đơn đã giao).
Thời gian vận chuyển TB =
    CALCULATE (
        AVERAGEX ( VALUES ( fact_delivery[order_id] ), CALCULATE ( MAX ( fact_delivery[transit_days] ) ) ),
        dim_delivery_status[delivery_result] IN { "Đúng hạn", "Trễ hạn" }
    )

// -----------------------------------------------------------------------------
// [M5]  Cờ người bán cần xử lý  |  thư mục: 3 Người bán  |  định dạng: 0
// M5. 1 nếu người bán có >= 30 đơn và (K8 < 3,5 hoặc K12 > 10%), ngược lại 0; dùng làm filter visual (tính trong ngữ cảnh 1 người bán).
Cờ người bán cần xử lý =
    VAR Diem = [Điểm đánh giá TB]
    VAR TreBG = [Tỉ lệ bàn giao trễ]
    RETURN
        IF (
            [Số đơn] >= 30
                && ( ( NOT ISBLANK ( Diem ) && Diem < 3.5 ) || ( NOT ISBLANK ( TreBG ) && TreBG > 0.1 ) ),
            1,
            0
        )

// -----------------------------------------------------------------------------
// Các measure dưới đây thêm 03/11/2026 khi dựng trang 3 (Q6 và trang ẩn Chi tiết người bán).

// -----------------------------------------------------------------------------
// [Q6]  Số người bán ≥ 30 đơn  |  thư mục: 3 Người bán  |  định dạng: #,0
// Q6. Số người bán có từ 30 đơn hợp lệ trở lên trong kỳ (mẫu số của tiêu đề Q6).
Số người bán ≥ 30 đơn = COUNTROWS ( FILTER ( VALUES ( dim_seller[seller_id] ), [Số đơn] >= 30 ) )

// -----------------------------------------------------------------------------
// [Q6]  Số người bán cần xử lý  |  thư mục: 3 Người bán  |  định dạng: #,0
// Q6. Số người bán có M5 = 1 (≥ 30 đơn và điểm TB < 3,5 hoặc bàn giao trễ > 10%).
Số người bán cần xử lý = COUNTROWS ( FILTER ( VALUES ( dim_seller[seller_id] ), [Cờ người bán cần xử lý] = 1 ) )

// -----------------------------------------------------------------------------
// [Q6]  Doanh thu NB cần xử lý  |  thư mục: 3 Người bán  |  định dạng: #,0
// Q6. Doanh thu của các người bán có M5 = 1; BLANK với người bán trong ngưỡng. Dùng cho Top N và data bar của bảng 10 người bán cần xử lý trước.
Doanh thu NB cần xử lý = SUMX ( VALUES ( dim_seller[seller_id] ), IF ( [Cờ người bán cần xử lý] = 1, [Doanh thu] ) )

// -----------------------------------------------------------------------------
// [Q6]  Tỉ trọng doanh thu NB cần xử lý  |  thư mục: 3 Người bán  |  định dạng: 0.00%
// Q6. Doanh thu của người bán có M5 = 1 / K1 của mọi người bán đang lọc (bỏ lọc từng người bán, nên không đổi khi visual chỉ giữ người bán ≥ 30 đơn).
Tỉ trọng doanh thu NB cần xử lý = DIVIDE ( [Doanh thu NB cần xử lý], CALCULATE ( [Doanh thu], REMOVEFILTERS ( dim_seller[seller_id] ) ) )

// -----------------------------------------------------------------------------
// [Q6]  Cảnh báo người bán  |  thư mục: 3 Người bán  |  định dạng: chữ
// Q6. Chữ nêu ngưỡng bị vượt của 1 người bán, VD "Trễ 30% · 3,49★"; trống nếu trong ngưỡng. Dùng làm cột trong bảng và tooltip.
Cảnh báo người bán =
    VAR _tre = [Tỉ lệ bàn giao trễ]
    VAR _diem = [Điểm đánh giá TB]
    VAR _a = IF ( _tre > 0.10, "Trễ " & FORMAT ( _tre, "0%", "vi-VN" ) )
    VAR _b = IF ( NOT ISBLANK ( _diem ) && _diem < 3.5, FORMAT ( _diem, "0.00", "vi-VN" ) & "★" )
    RETURN IF ( _a <> "" && _b <> "", _a & " · " & _b, _a & _b )

// -----------------------------------------------------------------------------
// [Trang ẩn]  Người bán đang xem  |  thư mục: 3 Người bán  |  định dạng: chữ
// Trang ẩn Chi tiết người bán: mã, thành phố, bang của người bán được drill-through.
Người bán đang xem =
    VAR _id = SELECTEDVALUE ( dim_seller[seller_id] )
    RETURN IF ( ISBLANK ( _id ), "Chọn 1 người bán (chuột phải → Drill through)", "Người bán " & _id & " · " & SELECTEDVALUE ( dim_seller[seller_city] ) & " – " & SELECTEDVALUE ( dim_seller[seller_state] ) )

// #############################################################################
// THƯ MỤC HIỂN THỊ: 3 Người bán\Thẻ KPI, 3 Người bán\Định dạng, 3 Người bán\Tiêu đề  (thêm 03/11/2026 khi dựng trang 3)
// Measure trả về CHỮ / mã màu chỉ dùng trên thẻ KPI, tiêu đề, tooltip và trong Format -> fx -> Field value,
// KHÔNG gọi trong công thức khác. Ngưỡng K12 theo business_questions.md mục 6; K13 không có ngưỡng số -> dòng phụ chỉ nêu số người bán; màu theo bảng màu trang 1.
// #############################################################################

// -----------------------------------------------------------------------------
// [Thẻ]  Số người bán hoạt động (thẻ)  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K10: số người bán dạng chữ có dấu chấm ngăn nghìn (3.029). Chỉ dùng trên thẻ.
Số người bán hoạt động (thẻ) = FORMAT ( [Số người bán hoạt động], "#,0", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Người bán hoạt động ghi chú  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K10: % và chênh lệch số người bán hoạt động 2018 so với 2017 trên cùng các tháng 1-8 đang chọn (cùng cách Số đơn so cùng kỳ của trang 1); theo lọc Tháng, Bang người bán; trả về "Không có cùng kỳ để so" khi chọn 2017 hoặc tháng 9-12. Chỉ dùng trên thẻ.
Người bán hoạt động ghi chú =
    VAR _nay = CALCULATE ( [Số người bán hoạt động], KEEPFILTERS ( dim_date[year] = 2018 ), KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _truoc = CALCULATE ( [Số người bán hoạt động], dim_date[year] = 2017, KEEPFILTERS ( dim_date[month] <= 8 ) )
    VAR _tang = DIVIDE ( _nay - _truoc, _truoc )
    RETURN
        IF ( ISBLANK ( _nay ) || ISBLANK ( _truoc ), "Không có cùng kỳ để so",
            IF ( _tang >= 0, "↑ ", "↓ " ) & FORMAT ( _tang, "+0%;-0%", "vi-VN" ) & " và "
                & FORMAT ( _nay - _truoc, "+#,0;-#,0", "vi-VN" ) & " người bán so cùng kỳ" )

// -----------------------------------------------------------------------------
// [Thẻ]  Doanh thu TB mỗi người bán (thẻ)  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K11: 4.440 BRL. Chỉ dùng trên thẻ.
Doanh thu TB mỗi người bán (thẻ) = FORMAT ( [Doanh thu TB mỗi người bán], "#,0", "vi-VN" ) & " BRL"

// -----------------------------------------------------------------------------
// [Thẻ]  Doanh thu TB mỗi người bán ghi chú  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K11: trung vị doanh thu mỗi người bán hoạt động (thấp hơn nhiều so với trung bình vì doanh thu dồn vào nhóm bán lớn - xem K13). Chỉ dùng trên thẻ.
Doanh thu TB mỗi người bán ghi chú =
    VAR _tv = MEDIANX ( VALUES ( fact_sales[seller_key] ), [Doanh thu] )
    RETURN IF ( ISBLANK ( _tv ), "Chưa có doanh thu", "Trung vị chỉ " & FORMAT ( _tv, "#,0", "vi-VN" ) & " BRL" )

// -----------------------------------------------------------------------------
// [Thẻ]  Tỉ lệ bàn giao trễ (thẻ)  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K12: 8,9%. Chỉ dùng trên thẻ.
Tỉ lệ bàn giao trễ (thẻ) = FORMAT ( [Tỉ lệ bàn giao trễ], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Bàn giao trễ so mục tiêu  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K12 theo ngưỡng K12 (≤ 5% tốt, > 10% cảnh báo), cùng kiểu Giao trễ so mục tiêu của trang 2.
Bàn giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ bàn giao trễ]
    RETURN
        SWITCH ( TRUE (),
            ISBLANK ( _v ), "Chưa có lượt bàn giao",
            _v > 0.10, "⚠ Vượt ngưỡng cảnh báo 10%",
            _v > 0.05, "⚠ Cao hơn mục tiêu 5%",
            "✓ Đạt mục tiêu (từ 5% trở xuống)" )

// -----------------------------------------------------------------------------
// [Thẻ]  Tỷ trọng top 10% người bán (thẻ)  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Hiển thị trên thẻ K13: 67,4%. Chỉ dùng trên thẻ.
Tỷ trọng top 10% người bán (thẻ) = FORMAT ( [Tỷ trọng doanh thu top 10% người bán], "0.0%", "vi-VN" )

// -----------------------------------------------------------------------------
// [Thẻ]  Top 10% người bán ghi chú  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Dòng phụ thẻ K13: số người bán thuộc nhóm 10% dẫn đầu (ROUNDUP như K13) / số người bán hoạt động. Chỉ dùng trên thẻ.
Top 10% người bán ghi chú =
    VAR _n = [Số người bán hoạt động]
    RETURN
        IF ( ISBLANK ( _n ), "Chưa có doanh thu",
            FORMAT ( ROUNDUP ( _n * 0.1, 0 ), "#,0", "vi-VN" ) & " / " & FORMAT ( _n, "#,0", "vi-VN" ) & " người bán dẫn đầu" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu bàn giao trễ so mục tiêu  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K12 theo bảng màu trang 1: trên mục tiêu 5% -> đỏ, đạt -> xanh, chưa có -> xám.
Màu bàn giao trễ so mục tiêu =
    VAR _v = [Tỉ lệ bàn giao trễ]
    RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#8B9099", _v > 0.05, "#D9483B", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu top 10% người bán  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K13 (thẻ nền đen): đỏ san hô như dòng phụ thẻ nền đen của trang 1 (doanh thu dồn vào nhóm nhỏ người bán).
Màu top 10% người bán = "#EF6F61"

// -----------------------------------------------------------------------------
// [Định dạng]  Màu người bán  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu chấm scatter Q6: M5 = 1 đỏ san hô, trong ngưỡng tím nhạt.
Màu người bán = IF ( [Cờ người bán cần xử lý] = 1, "#EF6F61", "#A9B8F8" )

// -----------------------------------------------------------------------------
// [Tiêu đề]  Tiêu đề Q5  |  thư mục: 3 Người bán\Tiêu đề  |  định dạng: chữ
// Câu kết luận Q5 theo bộ lọc: tỉ lệ giao trễ khi người bán bàn giao trễ so với bàn giao đúng hạn.
Tiêu đề Q5 =
    VAR _tre = CALCULATE ( [Tỉ lệ giao trễ], dim_delivery_status[handover_status] = "Trễ hạn" )
    VAR _dung = CALCULATE ( [Tỉ lệ giao trễ], dim_delivery_status[handover_status] = "Đúng hạn" )
    RETURN
        IF ( ISBLANK ( _tre ) || ISBLANK ( _dung ), "Chưa đủ dữ liệu bàn giao",
            "Bàn giao trễ → " & FORMAT ( _tre, "0.0%", "vi-VN" ) & " đơn giao trễ, gấp "
                & FORMAT ( DIVIDE ( _tre, _dung ), "0.0", "vi-VN" ) & " lần bàn giao đúng hạn ("
                & FORMAT ( _dung, "0.0%", "vi-VN" ) & ")" )

// -----------------------------------------------------------------------------
// [Tiêu đề]  Tiêu đề Q6  |  thư mục: 3 Người bán\Tiêu đề  |  định dạng: chữ
// Câu kết luận Q6 theo bộ lọc: số người bán vượt ngưỡng / số người bán ≥ 30 đơn và tỉ trọng doanh thu của họ.
Tiêu đề Q6 =
    FORMAT ( [Số người bán cần xử lý], "#,0", "vi-VN" ) & "/" & FORMAT ( [Số người bán ≥ 30 đơn], "#,0", "vi-VN" )
        & " người bán (≥ 30 đơn) vượt ít nhất 1 ngưỡng, chiếm "
        & FORMAT ( [Tỉ trọng doanh thu NB cần xử lý], "0.0%", "vi-VN" ) & " doanh thu"

// -----------------------------------------------------------------------------
// [Trang ẩn]  Doanh thu NB (thẻ)  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Trang ẩn Chi tiết người bán: doanh thu của người bán đang xem, dạng chữ (187.924 BRL). Chỉ dùng trên thẻ.
Doanh thu NB (thẻ) = FORMAT ( [Doanh thu], "#,0", "vi-VN" ) & " BRL"

// -----------------------------------------------------------------------------
// [Trang ẩn]  Người bán ghi chú  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Trang ẩn Chi tiết người bán: thành phố – bang của người bán đang xem (dòng phụ thẻ doanh thu).
Người bán ghi chú =
    VAR _c = SELECTEDVALUE ( dim_seller[seller_city] )
    VAR _s = SELECTEDVALUE ( dim_seller[seller_state] )
    RETURN IF ( ISBLANK ( _s ), "Chưa chọn người bán", _c & " – " & _s )

// -----------------------------------------------------------------------------
// [Trang ẩn]  Số đơn ghi chú  |  thư mục: 3 Người bán\Thẻ KPI  |  định dạng: chữ
// Trang ẩn Chi tiết người bán: dòng phụ thẻ số đơn.
Số đơn ghi chú = "Đơn hợp lệ trong kỳ"

// -----------------------------------------------------------------------------
// [Trang ẩn]  Màu ghi chú thẻ tối  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu chữ xám nhạt cho dòng phụ không có ngưỡng trên thẻ nền đen.
Màu ghi chú thẻ tối = "#B5BAC2"

// -----------------------------------------------------------------------------
// [Định dạng]  Màu so cùng kỳ người bán  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K10 theo ký tự đầu, cùng quy tắc Màu so cùng kỳ của trang 1: "↓" giảm -> đỏ, "K" (Không có cùng kỳ) -> xám, còn lại tăng -> xanh.
Màu so cùng kỳ người bán =
    VAR _t = LEFT ( [Người bán hoạt động ghi chú], 1 )
    RETURN SWITCH ( _t, "↓", "#D9483B", "K", "#8B9099", "#1D5E12" )

// -----------------------------------------------------------------------------
// [Định dạng]  Màu trung vị doanh thu NB  |  thư mục: 3 Người bán\Định dạng  |  định dạng: chữ
// Màu dòng phụ thẻ K11 (trung vị thấp hơn nhiều trung bình -> đỏ như dòng giảm của trang 1).
Màu trung vị doanh thu NB = "#D9483B"

// =============================================================================
// THƯ MỤC HIỂN THỊ: Hỏi AI  |  thêm 04/11/2026 cho nút "✦ Hỏi AI" ở header 3 trang (phần AI, ai/README.md)
// Link mở app Streamlit ai/app.py với đúng trang + slicer đang chọn; slicer không chọn hoặc chọn nhiều giá trị
// thì bỏ tham số đó (app hiểu là không lọc). Nút dùng measure qua Action -> Web URL (fx).
// =============================================================================

// -----------------------------------------------------------------------------
// [Hỏi AI]  Link hỏi AI trang 1  |  thư mục: Hỏi AI  |  định dạng: chữ
// Link nút Hỏi AI trang Tổng quan: mở biểu đồ Q1_1, mang theo nam, thang, vung, bang nếu slicer chọn đúng 1 giá trị.
Link hỏi AI trang 1 =
    "http://localhost:8501/?bieu_do=Q1_1"
        & IF ( HASONEVALUE ( dim_date[year] ), "&nam=" & VALUES ( dim_date[year] ) )
        & IF ( HASONEVALUE ( dim_date[month] ), "&thang=" & VALUES ( dim_date[month] ) )
        & IF ( HASONEVALUE ( dim_geography[region] ), "&vung=" & VALUES ( dim_geography[region] ) )
        & IF ( HASONEVALUE ( dim_geography[state_code] ), "&bang=" & VALUES ( dim_geography[state_code] ) )

// -----------------------------------------------------------------------------
// [Hỏi AI]  Link hỏi AI trang 2  |  thư mục: Hỏi AI  |  định dạng: chữ
// Link nút Hỏi AI trang Giao hàng: mở biểu đồ Q3_1, mang theo nam, thang, vung nếu slicer chọn đúng 1 giá trị.
Link hỏi AI trang 2 =
    "http://localhost:8501/?bieu_do=Q3_1"
        & IF ( HASONEVALUE ( dim_date[year] ), "&nam=" & VALUES ( dim_date[year] ) )
        & IF ( HASONEVALUE ( dim_date[month] ), "&thang=" & VALUES ( dim_date[month] ) )
        & IF ( HASONEVALUE ( dim_geography[region] ), "&vung=" & VALUES ( dim_geography[region] ) )

// -----------------------------------------------------------------------------
// [Hỏi AI]  Link hỏi AI trang 3  |  thư mục: Hỏi AI  |  định dạng: chữ
// Link nút Hỏi AI trang Người bán: mở biểu đồ Q5_1, mang theo nam, thang, bang_nb nếu slicer chọn đúng 1 giá trị.
Link hỏi AI trang 3 =
    "http://localhost:8501/?bieu_do=Q5_1"
        & IF ( HASONEVALUE ( dim_date[year] ), "&nam=" & VALUES ( dim_date[year] ) )
        & IF ( HASONEVALUE ( dim_date[month] ), "&thang=" & VALUES ( dim_date[month] ) )
        & IF ( HASONEVALUE ( dim_seller[seller_state] ), "&bang_nb=" & VALUES ( dim_seller[seller_state] ) )
